# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
# logs de execução local (build/dev/testes)
*.log

# saída temporária de comandos executados manualmente
*.txt
!supabase/**/*.txt

# cluster PostgreSQL local usado na validação (tarefa 2.18)
# — dados binários; nunca versionados. O cluster é recriável com
#   npm run db:reset-local
/.local/

# env files (can opt-in for committing if needed)
.env*
# o arquivo de exemplo é versionado de propósito (documenta as variáveis)
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
