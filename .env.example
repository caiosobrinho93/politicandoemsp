# Copie este arquivo para `.env.local` e preencha com as credenciais do seu
# projeto Supabase. Nenhuma dessas variáveis deve ser preenchida com valor de
# exemplo: enquanto elas estiverem vazias, a plataforma opera sem banco de dados.
#
# IMPORTANTE
# - `.env.local` nunca é versionado (ver .gitignore).
# - A chave `service_role` NUNCA pode ser exposta em variável NEXT_PUBLIC_*:
#   ela ignora as políticas de RLS e só pode ser usada no servidor.

# URL do projeto Supabase (ex.: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Chave pública (anon) do projeto Supabase — uso no navegador, respeita RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave de serviço — uso exclusivo em scripts/servidor com privilégio elevado
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de onde a aplicação é servida (usada em links absolutos e SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Provedor de notícias previsto para a coleta de matérias (FASE 07).
# Deixe vazio enquanto a integração não for configurada.
NEWS_PROVIDER_API_KEY=
